\RequirePackage{babel}
\babelprovide[import,main]{danish}
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage[a4paper,margin=26mm,headheight=16pt]{geometry}
\RequirePackage{microtype,booktabs,longtable,array}
\tracinglostchars=3

\RequirePackage{xcolor,graphicx,tikz,pgfplots}
\pgfplotsset{compat=1.18}
\definecolor{arkivblaa}{HTML}{174B6B}
\definecolor{arkivrod}{HTML}{B34832}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily Fysik · matematik}
\fancyhead[R]{\small\sffamily\nouppercase{\leftmark}}
\fancyfoot[C]{\thepage}
\renewcommand{\chaptermark}[1]{\markboth{\thechapter.\ #1}{}}
\RequirePackage[unicode,colorlinks=true,linkcolor=arkivblaa,urlcolor=arkivblaa,citecolor=arkivblaa,bookmarksnumbered=true]{hyperref}
\RequirePackage{bookmark}
\hypersetup{pdfauthor={Fysik-studiearkiv},pdftitle={Matematik til universitetsfysik},pdfsubject={Dansk studiekompendium}}
\addto\captionsdanish{\renewcommand{\contentsname}{Indholdsfortegnelse}\renewcommand{\chaptername}{Kapitel}\renewcommand{\figurename}{Figur}\renewcommand{\tablename}{Tabel}}
\newtheorem{definition}{Definition}[chapter]
\newtheorem{saetning}[definition]{Sætning}
\theoremstyle{remark}
\newtheorem*{bemaerkning}{Bemærkning}
\newcommand{\R}{\mathbb{R}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\newcommand{\e}{\mathrm{e}}
\newcommand{\planlagt}[1]{\begin{quote}\small\sffamily\color{arkivblaa}Planlagt kapitel. #1 Dette er en redaktionel disposition, ikke et færdigt fagligt afsnit.\end{quote}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\setcounter{tocdepth}{1}
\setcounter{secnumdepth}{2}
\emergencystretch=1.5em

\makeatletter
\renewcommand*\l@section{\@dottedtocline{1}{1.5em}{3.0em}}
\makeatother

% Opt-in: kun bind 1 bruger det nye bogdesign. Standardudgaver bevares.
\newcommand{\formel}[3]{%
  \begin{equation}\label{#1}#3\end{equation}%
  \addcontentsline{for}{section}{\protect\numberline{\theequation}#2}%
}
\newcommand{\formelhenvisning}[2]{%
  \phantomsection\addcontentsline{for}{section}{#2: \protect\ref{#1}}}
\makeatletter
\newcommand{\formelregister}{%
  \chapter*{Formelregister}\markboth{Formelregister}{Formelregister}\phantomsection
  \addcontentsline{toc}{chapter}{Formelregister}
  Formlerne står ved deres forklaringer og gyldighedsbetingelser.
  Klik på en post for at gå direkte til formlen.\par\medskip
  \begingroup\small\@starttoc{for}\endgroup}
